{
  "expo": {
    "name": "TRILLION",
    "slug": "trillion",
    "scheme": "trillion",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "android": {
      "package": "app.trillion.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#062A1E"
      },
      "versionCode": 6
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.160713321951-3m81u5gkpsc6c12fhqn57gb0o4qb7cl5"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://trillion-api.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7ddfb9f0-891e-4c89-bf99-0a678a65dc1d"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "owner": "officialdarax"
  }
}
