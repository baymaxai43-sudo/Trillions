# Copy to .env for local dev. NEVER commit real keys. In production use the host's secret manager.
# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# --- AI providers (server-side only; comma-separate multiple keys) ---
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
# --- API ---
PORT=4000
CORS_ORIGINS=http://localhost:8081
# --- Agent harness (Phase 3) ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts connector tokens. Never rotate without re-connecting.
CONNECTOR_ENC_KEY=
API_PUBLIC_URL=https://trillion-api.onrender.com
APP_REDIRECT_URL=trillion://connections
AGENT_MAX_STEPS=12
AGENT_MAX_ACTIVE=20
AGENT_SCHEDULER=on
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Optional web search (one of)
TAVILY_API_KEY=
BRAVE_API_KEY=
# Code execution is OFF by default (no safe sandbox on Render free)
AGENT_ENABLE_CODE=false
E2B_API_KEY=
