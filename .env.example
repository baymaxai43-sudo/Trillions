# Copy to .env for local dev. NEVER commit real keys. In production use the host's secret manager.
# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# --- AI providers (server-side only; comma-separate multiple keys) ---
# Comma-separated, e.g. key1,key2,key3. Free-tier limits are per Google Cloud project,
# so keys from 3 different projects give 3x the quota; keys from one project share it.
GEMINI_API_KEYS=
# Gemini 3.1 Pro has no free tier. Set to true only if the keys' projects have billing.
GEMINI_PRO_ENABLED=false
# Order the agent tries models in (unusable ones are skipped; the rest stay as fallbacks).
AI_PREFERRED_MODELS=gemini-3.1-pro-preview,gemini-3.1-flash-lite
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
# --- API ---
PORT=4000
CORS_ORIGINS=http://localhost:8081
# --- Agent harness (Phase 3) ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts connector tokens. Never rotate without re-connecting.
CONNECTOR_ENC_KEY=
AGENT_MAX_STEPS=12
AGENT_MAX_ACTIVE=20
AGENT_SCHEDULER=on
# Connectors are token-only: each user pastes their own GitHub/Vercel/Render/Supabase/Netlify token in the app.
# No OAuth client IDs or secrets are needed on the server.
# Optional web search (one of)
TAVILY_API_KEY=
BRAVE_API_KEY=
# Code execution is OFF by default (no safe sandbox on Render free)
AGENT_ENABLE_CODE=false
E2B_API_KEY=
